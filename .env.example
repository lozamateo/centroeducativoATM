# Copiar como .env y completar. Nunca subir el .env real al repositorio.

# Supabase -> Conecta -> Directo -> Session pooler (con la contrasena de la base)
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Clave para firmar los tokens JWT: cualquier texto largo y secreto
JWT_SECRET=cambiar-por-un-texto-largo-y-secreto

PORT=3001
